{
  "name": "bnak-hugo",
  "version": "1.0.0",
  "description": "Biashara Ndogo Association of Kenya — Hugo and Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/compiled.css --minify",
    "build": "npm run build:css && node scripts/hugo.cjs --gc --minify --cleanDestinationDir",
    "watch": "tailwindcss -i ./assets/css/main.css -o ./assets/css/compiled.css --watch",
    "server": "node scripts/hugo.cjs server --bind 127.0.0.1",
    "start": "npm run build:css && concurrently \"npm:server\" \"npm:watch\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.0"
  }
}
